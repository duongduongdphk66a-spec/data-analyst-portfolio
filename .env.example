# Production domain for SEO sitemap, canonical links, and OpenGraph metadata
NEXT_PUBLIC_SITE_URL="https://mavanhung-portfolio.vercel.app"

# ==========================================
# Cấu hình Xác thực Quản trị (Admin Authentication)
# Lưu ý: Hãy đổi cả mật khẩu và mã xác nhận trước khi deploy lên môi trường Production
# ==========================================
ADMIN_PASSWORD="your_admin_password_here"
ADMIN_VERIFY_CODE="your_security_verify_code_here"

# ==========================================
# Cấu hình Reverse Proxy & Rate Limiting IP
# ==========================================
# Mặc định: "false" (an toàn nhất, chống giả mạo IP khi chạy trực tiếp Node/Docker).
# Chỉ bật "true" KHI VÀ CHỈ KHI máy chủ thực sự đứng sau Reverse Proxy tin cậy (Cloudflare, Nginx, ALB)
# và firewall đã chặn hoàn toàn truy cập trực tiếp vào port ứng dụng từ ngoài Internet.
TRUST_PROXY="false"

# ==========================================
# Cấu hình Cơ sở dữ liệu MySQL (Backend Database)
# ==========================================
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DATABASE="portfolio_db"
MYSQL_CONNECT_TIMEOUT=1000

# Hoặc dùng Connection URL (Cloud MySQL: PlanetScale, Aiven, Railway, Clever Cloud):
# DATABASE_URL="mysql://root:password@localhost:3306/portfolio_db"

# ==========================================
# Docker Compose (chỉ dùng khi chạy docker-compose up)
# ==========================================
MYSQL_ROOT_PASSWORD="changeme_root_password_docker"
